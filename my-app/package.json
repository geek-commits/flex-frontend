{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build && node scripts/precompress.mjs",
        "build:ssr": "vite build && vite build --ssr && node scripts/precompress.mjs",
        "dev": "vite",
        "format": "prettier --write resources/",
        "format:check": "prettier --check resources/",
        "lint": "eslint . --fix",
        "lint:check": "eslint .",
        "types:check": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "perf:audit": "node scripts/perf-audit.mjs",
        "icons:audit": "python3 resources/assets/flex/brand/validate-svg-sources.py resources/assets/flex/brand && python3 resources/assets/flex/icons/validate-flex-icons.py resources/assets/flex/icons"
    },
    "devDependencies": {
        "@eslint/js": "^9.19.0",
        "@laravel/vite-plugin-wayfinder": "^0.1.3",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@testing-library/jest-dom": "^6",
        "@testing-library/react": "^16",
        "@testing-library/user-event": "^14",
        "@types/node": "^22.13.5",
        "babel-plugin-react-compiler": "^1.0.0",
        "eslint": "^9.17.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-react": "^7.37.3",
        "eslint-plugin-react-hooks": "^7.0.0",
        "jsdom": "^26",
        "prettier": "^3.4.2",
        "prettier-plugin-tailwindcss": "^0.6.11",
        "typescript-eslint": "^8.23.0",
        "vite-plugin-svgr": "^5.2.0",
        "vitest": "^3"
